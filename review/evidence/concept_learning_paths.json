  "graph_examples": {
    "bern04": {
      "label": "CDF practice: Bernoulli(p=0.4)",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "bern",
      "inputs": {
        "p_bern": 0.40000000000000002
      },
      "x": 0,
      "note": "P(X=0)=0.6 and P(X=1)=0.4. The CDF at 0 includes X=0; compare strict and inclusive inequalities."
    },
    "corn5": {
      "label": "Corn: Binomial(n=5,p=0.2)",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "binom",
      "inputs": {
        "n": 5,
        "p": 0.20000000000000001
      },
      "x": 0,
      "note": "Given 5 inspected plants, Y is Binomial(5,0.2). P(Y>=1)=1-F(0)=0.67232."
    },
    "corn10": {
      "label": "Corn: Binomial(n=10,p=0.2), mean 2",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "binom",
      "inputs": {
        "n": 10,
        "p": 0.20000000000000001
      },
      "x": 2,
      "note": "With 10 independent inspected plants, the expected count is np=10*0.2=2."
    },
    "novice": {
      "label": "Novice: Geometric(p=0.2), failures Z",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "geom",
      "inputs": {
        "pg": 0.20000000000000001
      },
      "x": 1,
      "note": "Z counts failures before success, and attempts Y=Z+1. P(Y>=3)=P(Z>=2)=1-F_Z(1)=0.64."
    },
    "du5": {
      "label": "Second moments: Discrete Uniform on 1,...,5",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "dunifd",
      "inputs": {
        "N_du": 5
      },
      "x": 3,
      "note": "DU(5) has mean 3. Averaging squared outcomes gives E[Z^2]=11; variance=11-9=2."
    },
    "tokens": {
      "label": "Red tokens: Hypergeometric(n=5,M=8,N=20)",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "hyper",
      "inputs": {
        "n_hy": 5,
        "M_hy": 8,
        "N_hy": 20
      },
      "x": 2,
      "note": "Draw 5 tokens without replacement from 20, including 8 red. The conditional mean is nM/N=2."
    },
    "worker_nb": {
      "label": "Worker: Negative Binomial(k=2,p=1/4)",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "nbinom",
      "inputs": {
        "r_nb": 2,
        "p_nb": 0.25
      },
      "x": 6,
      "note": "Y counts failures before the second success in independent trials. Its mean is k(1-p)/p=6."
    },
    "eggs_cloudy": {
      "label": "Cloudy eggs: Poisson(12), P(Y <= 10)",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "pois",
      "inputs": {
        "lambda": 12
      },
      "x": 10,
      "note": "Cloudy: 2 eggs/hour for 6 hours gives lambda=12. The highlighted CDF at 10 is P(Y <= 10), about 0.3472."
    },
    "eggs_sunny": {
      "label": "Sunny eggs: Poisson(24), mean 24",
      "paths": ["core", "legacy"],
      "type": "discrete",
      "dist": "pois",
      "inputs": {
        "lambda": 24
      },
      "x": 24,
      "note": "Sunny: 4 eggs/hour for 6 hours gives lambda=24. The count mean is 24; the rate per hour is 4."
    },
    "rain": {
      "label": "Rain waiting time: Exponential(rate=0.5)",
      "paths": ["preview", "further", "legacy"],
      "type": "continuous",
      "dist": "exp",
      "inputs": {
        "rate_exp": 0.5
      },
      "x": 2,
      "note": "Cloudy rain model: rate=0.5 per hour, mean waiting time=2 hours. The CDF at 2 is about 0.6321."
    },
    "normal65": {
      "label": "Strawberries: Normal(mean=65, sd=3)",
      "paths": ["preview", "further", "legacy"],
      "type": "continuous",
      "dist": "norm",
      "inputs": {
        "mean_norm": 65,
        "sd_norm": 3
      },
      "x": 70,
      "note": "For fertility X=3, the mean is 65 and the variance is 9 (standard deviation 3). The tail above 70 is 1-F(70), about 0.0478."
    },
    "uniform140": {
      "label": "Grazing: Uniform(0,140)",
      "paths": ["preview", "further", "legacy"],
      "type": "continuous",
      "dist": "unif",
      "inputs": {
        "a_unif": 0,
        "b_unif": 140
      },
      "x": 50,
      "note": "At W=2, the assumed upper bound is 140. P(Y>50)=1-F(50)=90/140=9/14; a single point still has probability zero."
    },
    "uniform100": {
      "label": "Grazing: Uniform(0,100)",
      "paths": ["further", "legacy"],
      "type": "continuous",
      "dist": "unif",
      "inputs": {
        "a_unif": 0,
        "b_unif": 100
      },
      "x": 50,
      "note": "The optional second-moment exercise uses Uniform(0,100). The density is 1/100 and E[X^2]=10000/3."
    },
    "normal50": {
      "label": "Strawberries: Normal(mean=50, sd=3)",
      "paths": ["preview", "further", "legacy"],
      "type": "continuous",
      "dist": "norm",
      "inputs": {
        "mean_norm": 50,
        "sd_norm": 3
      },
      "x": 50,
      "note": "Mean 50, variance 9, standard deviation 3. The expected squared deviation from the mean is the variance."
    },
    "exp2": {
      "label": "Waiting time: Exponential(rate=2)",
      "paths": ["further", "legacy"],
      "type": "continuous",
      "dist": "exp",
      "inputs": {
        "rate_exp": 2
      },
      "x": 0.5,
      "note": "The optional second-moment exercise uses rate 2; the mean is 1/2 and E[X^2]=1/2."
    }
