  "proposed_core_exercises": [
    {
      "id": "B01",
      "objective": "Construct a valid joint PMF from 20 fictional observations",
      "expected": [
        "3/10",
        "1/5",
        "1/10",
        "2/5"
      ]
    },
    {
      "id": "B02",
      "objective": "Bernoulli(.4) CDF and endpoint inequalities",
      "expected": {
        "F(0)": "3/5",
        "P(X<1)": "3/5",
        "P(X>=1)": "2/5",
        "P(X>1)": "0"
      }
    },
    {
      "id": "B03",
      "objective": "Obtain marginals by summing joint cells",
      "expected": {
        "P(X=1)": "1/2",
        "P(Y=1)": "3/5"
      }
    },
    {
      "id": "B04",
      "objective": "Distinguish joint, conditional and reverse conditional probabilities",
      "expected": {
        "P(X=1,Y=1)": "2/5",
        "P(Y=1|X=1)": "4/5",
        "P(X=1|Y=1)": "2/3"
      }
    },
    {
      "id": "B05",
      "objective": "One counterexample refutes independence. Proving it requires checking all supported cells.",
      "expected": {
        "independent": false,
        "actual": "2/5",
        "product": "3/10"
      }
    },
    {
      "id": "B06",
      "objective": "Conditional and total expectation, first fixing X and then averaging over X",
      "expected": {
        "E(Y|X=0)": "2/5",
        "E(Y|X=1)": "4/5",
        "E(Y)": "3/5",
        "E(E(Y|X))": "3/5",
        "E(XY)": "2/5"
      }
    },
    {
      "id": "B07",
      "objective": "E[X^2], E[X]^2 and variance for DU(5)",
      "expected": {
        "E(X^2)": "11",
        "E(X)^2": "9",
        "Var(X)": "2"
      }
    },
    {
      "id": "B08",
      "objective": "Conditional distribution undefined for a zero marginal",
      "expected": {
        "P(X=0)": "0",
        "P(Y=1|X=0)": "undefined",
        "P(Y=1|X=1)": "3/4"
      },
      "variant_joint": [
        [
          "0",
          "0"
        ],
        [
          "1/4",
          "3/4"
        ]
      ]
    }
  ],
